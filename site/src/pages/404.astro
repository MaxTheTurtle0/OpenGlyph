---
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found · OpenGlyph</title>
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body>
    <main class="wrap" style="min-height:100vh;display:grid;place-content:center;text-align:center;gap:1.2rem">
      <img src="/icon.png" alt="" width="80" height="80" style="margin:0 auto;border-radius:18px" />
      <h1 style="margin:0;font-weight:800;letter-spacing:-.05em;line-height:.95;font-size:clamp(2.6rem,8vw,6rem)">No text<br />recognized.</h1>
      <p><a href="/">Back to OpenGlyph</a></p>
    </main>
  </body>
</html>
