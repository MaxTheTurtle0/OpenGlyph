---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/figtree";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found · OpenGlyph</title>
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body>
    <main class="wrap" style="min-height:100vh;display:grid;place-content:center;text-align:center;gap:1.2rem">
      <img src="/icon.png" alt="" width="80" height="80" style="margin:0 auto;border-radius:18px" />
      <h1 style="font-size:clamp(2.6rem,7vw,4.5rem)">Nothing to <em>recognize</em> here.</h1>
      <p><a class="btn btn-primary" href="/">Back to OpenGlyph</a></p>
    </main>
  </body>
</html>
